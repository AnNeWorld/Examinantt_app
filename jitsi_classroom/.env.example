# =============================================================================
# 8x8 JaaS (Jitsi as a Service) & Jitsi Configuration
# =============================================================================

# JaaS App ID (format: vpaas-magic-cookie-xxxxxxxxxx)
JAAS_APP_ID="vpaas-magic-cookie-examinantt-app"
NEXT_PUBLIC_JAAS_APP_ID="vpaas-magic-cookie-examinantt-app"

# JaaS API Key ID (format: vpaas-magic-cookie-xxxxxxxxxx/key-id)
JAAS_API_KEY_ID="vpaas-magic-cookie-examinantt-app/prod-key-1"

# RSA-256 Private Key (.pk content from 8x8 JaaS Console)
# Ensure newline characters are escaped as \n if placed in a single line
JAAS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0r1...example...key...\n-----END RSA PRIVATE KEY-----"

# Domain: "8x8.vc" for JaaS, or "meet.jit.si" for public Jitsi, or your self-hosted domain
JITSI_DOMAIN="8x8.vc"
NEXT_PUBLIC_JITSI_DOMAIN="8x8.vc"

# =============================================================================
# AWS S3 Configuration (for Resumable Multipart Video Uploads)
# =============================================================================
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="examinantt-classroom-recordings"
